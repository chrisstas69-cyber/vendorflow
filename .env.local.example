# === VendorFlow — Airtable (server-side only) ===
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# === Event scraper — Google Sheets export (optional) ===
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=

# === Transactional email and digest ===
RESEND_API_KEY=
RESEND_FROM="VendorFlow <hello@vendorflow.app>"
GMAIL_FROM=
GMAIL_APP_PASSWORD=
GMAIL_TO=

# === Cron protection (Vercel) ===
CRON_SECRET=

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3002
AUTH_SECRET=
ADMIN_EMAILS=

# === Platform database (Neon Postgres — see docs/DATABASE-NEON.md) ===
# Pooled URL for runtime (serverless):
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Direct URL for migrations. The build also maps Vercel's DATABASE_URL_UNPOOLED automatically.
DIRECT_URL="postgresql://USER:PASS@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# === Pilot mode (Founders Edition) ===
# seed = in-memory (resets on Vercel cold start) | db = Neon Postgres
PILOT_DATA_SOURCE=db
PILOT_MODE=true
# Supabase Storage (server-only service key; never expose it with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Payments ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Monitoring ===
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
